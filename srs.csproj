<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>srs</AssemblyName>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Celeste.Mod.SpeedrunSheet</RootNamespace>
        <DebugType>portable</DebugType>
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3270</MSBuildWarningsAsMessages>
        <!-- auto-detected when the repo lives in <Celeste>/Mods/xxx/, otherwise pass -p:CelestePrefix=/path/to/Celeste -->
        <CelestePrefix Condition="'$(CelestePrefix)' == '' And Exists('../../../Celeste.dll')">../../..</CelestePrefix>
        <SpeedrunToolZip>$(CelestePrefix)/Mods/SpeedrunTool.zip</SpeedrunToolZip>
        <SpeedrunToolRefDir>$(BaseIntermediateOutputPath)SpeedrunToolRef/</SpeedrunToolRefDir>
        <!-- fallback for a machine with no Celeste install: a DLL pre-extracted next to the stripped assemblies -->
        <SpeedrunToolRefDir Condition="!Exists('$(SpeedrunToolZip)') And Exists('$(CelestePrefix)/SpeedrunTool.dll')">$(CelestePrefix)/</SpeedrunToolRefDir>
    </PropertyGroup>

    <!-- the SDK globs **/*.cs by default: without this the test project's own
         sources (and its obj/ generated files) would be compiled into srs.dll -->
    <ItemGroup>
        <Compile Remove="Tests/**" />
    </ItemGroup>

    <!-- CelesteHotkeys/src is compiled by the SDK's default glob, like Source/. -->
    <Target Name="CheckCelesteHotkeys" BeforeTargets="BeforeBuild">
        <Error Condition="!Exists('$(MSBuildThisFileDirectory)CelesteHotkeys/src')"
               Text="CelesteHotkeys/src is missing. It is committed in this repository; restore it from git." />
    </Target>

    <ItemDefinitionGroup>
        <Reference>
            <Private>False</Private>
        </Reference>
    </ItemDefinitionGroup>

    <ItemGroup>
        <!-- the vendored menu components (Source/MenuTools) read private members of Celeste -->
        <PackageReference Include="CelesteMod.Publicizer" Version="1.1.2" CelesteAssembly="$(CelestePrefix)/Celeste.dll" PrivateAssets="all" ExcludeAssets="runtime" />
        <Reference Include="$(CelestePrefix)/FNA.dll" />
        <Reference Include="$(CelestePrefix)/MMHOOK_Celeste.dll" />
        <Reference Include="$(CelestePrefix)/MonoMod.Utils.dll" />
        <Reference Include="$(CelestePrefix)/MonoMod.RuntimeDetour.dll" />
        <!-- compiled against the DLL of the installed official SpeedrunTool.zip, extracted below -->
        <Reference Include="SpeedrunTool">
            <HintPath>$(SpeedrunToolRefDir)SpeedrunTool.dll</HintPath>
        </Reference>
    </ItemGroup>

    <Target Name="ExtractSpeedrunToolDll" BeforeTargets="ResolveAssemblyReferences" Condition="Exists('$(SpeedrunToolZip)') Or !Exists('$(CelestePrefix)/SpeedrunTool.dll')">
        <Error Condition="!Exists('$(SpeedrunToolZip)')"
               Text="SpeedrunTool.zip not found ($(SpeedrunToolZip)): pass -p:CelestePrefix=&lt;Celeste folder&gt;" />
        <Unzip SourceFiles="$(SpeedrunToolZip)" DestinationFolder="$(SpeedrunToolRefDir)" OverwriteReadOnlyFiles="true" />
    </Target>

    <!-- mod structure ready to copy into Mods/srs/ -->
    <ItemGroup>
        <DialogResources Include="$(MSBuildProjectDirectory)/Dialog/**/*" />
    </ItemGroup>
    <Target Name="OutputAsModStructure" AfterTargets="Build">
        <!-- bin/ and not the mod root: that is where everest.yaml points, and where the deploy expects the DLL -->
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="build/bin" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="build/bin" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="bin" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="bin" />
        <Copy SourceFiles="everest.yaml" DestinationFolder="build" />
        <Copy SourceFiles="@(DialogResources)" DestinationFolder="build/Dialog/%(RecursiveDir)" SkipUnchangedFiles="true" />
    </Target>
</Project>
